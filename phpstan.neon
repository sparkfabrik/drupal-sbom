parameters:
  level: 6
  # The ignores below match identifiers of extensions CI may not install.
  reportUnmatchedIgnoredErrors: false
  paths:
    - .
  excludePaths:
    - vendor (?)
  ignoreErrors:
    # Drupal tests call PHPUnit assertions through $this.
    - identifier: staticMethod.dynamicCall
      path: tests/*
    # Plugin attributes redeclare the parent properties, as core attributes do.
    - identifier: constructor.missingParentCall
      path: src/Attribute/*
    # Drupal coding standards forbid repeating the hook @return documentation.
    - identifier: missingType.iterableValue
      path: drubom.install
    # Guzzle 8 promises are generic; the Guzzle 7 promises of Drupal 11 are not.
    - identifier: generics.notGeneric
      path: tests/src/Unit/Advisory/JsonRequestsTest.php
